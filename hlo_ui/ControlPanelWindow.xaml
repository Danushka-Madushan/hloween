<Window x:Class="KioskOverlay.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🎃 Halloween Kiosk Control Panel"
        Width="700" Height="740"
        MinWidth="600" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#121118"
        Foreground="#EEEEEE"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Reusable Card Style -->
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="#1A1822"/>
            <Setter Property="BorderBrush" Value="#2E2A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Modern Action Button Style -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#FF6B00"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF852A"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#D95B00"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#2A2636"/>
            <Setter Property="Foreground" Value="#DCD8E8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3B364C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Danger Button Style (Emergency / Terminate) -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#A8201A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C92A23"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#7A140F"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- ESP32 Status Card -->
            <RowDefinition Height="Auto"/> <!-- Settings & Actions Card -->
            <RowDefinition Height="*"/>    <!-- Live Event Log Card -->
        </Grid.RowDefinitions>

        <!-- ================= 1. HEADER ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="🎃 HALLOWEEN KIOSK CONTROLLER"
                           FontSize="20" FontWeight="Bold" Foreground="#FF6B00"/>
                <TextBlock Text="ESP32 Door Sensor Status &amp; Alert Configuration (Ctrl+Q to exit)"
                           FontSize="12" Foreground="#888496" Margin="0,3,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#261A0F" BorderBrush="#FF6B00" BorderThickness="1"
                    CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                <TextBlock Text="OPERATOR DASHBOARD" FontSize="11" FontWeight="Bold" Foreground="#FF852A"/>
            </Border>
        </Grid>

        <!-- ================= 2. ESP32 STATUS CARD ================= -->
        <Border Grid.Row="1" Style="{StaticResource PanelCard}">
            <StackPanel>
                <!-- Status Bar with Badge -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="14" Height="14" Fill="#FF3B30" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusBadge" Text="SEARCHING FOR ESP32..."
                                   FontSize="15" FontWeight="Bold" Foreground="#FF453A"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="OpenWebUiButton" Content="Open ESP Web Dashboard"
                            Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="11"
                            Click="OpenWebUiButton_Click"/>
                </Grid>

                <!-- Status Telemetry Grid -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- IP Address -->
                    <Border Grid.Column="0" Background="#13121A" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="ESP32 IP" FontSize="11" Foreground="#888496"/>
                            <TextBlock x:Name="TxtIpAddress" Text="---" FontSize="13" FontWeight="Bold" Foreground="#F0EDF6" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- Distance -->
                    <Border Grid.Column="1" Background="#13121A" CornerRadius="6" Padding="10" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="SENSOR DISTANCE" FontSize="11" Foreground="#888496"/>
                            <TextBlock x:Name="TxtDistance" Text="-- cm" FontSize="13" FontWeight="Bold" Foreground="#00FF88" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Door State -->
                    <Border Grid.Column="2" Background="#13121A" CornerRadius="6" Padding="10" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="DOOR STATE" FontSize="11" Foreground="#888496"/>
                            <TextBlock x:Name="TxtDoorState" Text="UNKNOWN" FontSize="13" FontWeight="Bold" Foreground="#FFB340" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Triggers Count -->
                    <Border Grid.Column="3" Background="#13121A" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="TOTAL TRIGGERS" FontSize="11" Foreground="#888496"/>
                            <TextBlock x:Name="TxtTriggers" Text="0" FontSize="13" FontWeight="Bold" Foreground="#FF6B00" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ================= 3. SETTINGS & ACTIONS CARD ================= -->
        <Border Grid.Row="2" Style="{StaticResource PanelCard}">
            <StackPanel>
                <!-- Alert Display Duration Slider -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Minimum Alert Display Duration:" FontSize="13" FontWeight="SemiBold" Foreground="#E0DCE8"/>
                    <TextBlock Grid.Column="1" x:Name="TxtDurationValue" Text="14 seconds" FontSize="13" FontWeight="Bold" Foreground="#FF6B00"/>
                </Grid>

                <Slider x:Name="DurationSlider" Minimum="4" Maximum="30" Value="14"
                        SmallChange="1" LargeChange="2" TickFrequency="2" IsSnapToTickEnabled="True"
                        Margin="0,0,0,6" ValueChanged="DurationSlider_ValueChanged"/>

                <TextBlock Text="How long the poster stays on screen. If speech audio is longer (+0.8s), popup duration extends automatically."
                           FontSize="11" Foreground="#777385" Margin="0,0,0,14"/>

                <Separator Background="#2E2A3A" Margin="0,0,0,14"/>

                <!-- Controls & Actions -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" x:Name="ChkDemoTimer" Content="Enable Auto Demo Timer (every 15s)"
                              FontSize="12" Foreground="#DCD8E8" VerticalAlignment="Center"
                              Checked="ChkDemoTimer_CheckedChanged" Unchecked="ChkDemoTimer_CheckedChanged"/>

                    <Button Grid.Column="1" x:Name="BtnManualTrigger" Content="⚡ Test Alert Popup"
                            Style="{StaticResource ActionButton}" Margin="0,0,10,0" Click="BtnManualTrigger_Click"/>

                    <Button Grid.Column="2" x:Name="BtnTerminate" Content="🛑 Terminate Program"
                            Style="{StaticResource DangerButton}" Click="BtnTerminate_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ================= 4. LIVE EVENT LOG ================= -->
        <Border Grid.Row="3" Style="{StaticResource PanelCard}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="LIVE EVENT LOG" FontSize="11" FontWeight="Bold" Foreground="#888496"/>
                    <Button Grid.Column="1" Content="Clear Log" Background="Transparent" Foreground="#888496"
                            BorderThickness="0" FontSize="11" Cursor="Hand" Click="ClearLog_Click"/>
                </Grid>

                <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBox x:Name="TxtEventLog"
                             Background="#0B0A0F" Foreground="#4ADE80"
                             FontFamily="Consolas" FontSize="12"
                             BorderBrush="#252230" BorderThickness="1"
                             IsReadOnly="True" TextWrapping="Wrap"
                             Padding="8" VerticalAlignment="Stretch"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>