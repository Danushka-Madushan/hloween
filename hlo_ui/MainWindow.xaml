<Window x:Class="KioskOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KioskAlert"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#0D0B10"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Reusable glowing ember style -->
        <RadialGradientBrush x:Key="WarmGlowBrush">
            <GradientStop Color="#88FF6B00" Offset="0.0"/>
            <GradientStop Color="#33FF4500" Offset="0.45"/>
            <GradientStop Color="#00FF6B00" Offset="1.0"/>
        </RadialGradientBrush>

        <RadialGradientBrush x:Key="MoonGlowBrush">
            <GradientStop Color="#44FFF3C4" Offset="0.0"/>
            <GradientStop Color="#15FFAE00" Offset="0.55"/>
            <GradientStop Color="#00000000" Offset="1.0"/>
        </RadialGradientBrush>
    </Window.Resources>

    <Grid Background="#0D0B10" ClipToBounds="True">

        <!-- ================= LAYER 1: FULLSCREEN POSTER (100% CLEAR) ================= -->
        <Image x:Name="PosterImage"
               Source="pack://siteoforigin:,,,/Assets/poster.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"
               RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <ScaleTransform x:Name="PosterBreathScale" ScaleX="1.0" ScaleY="1.0"/>
            </Image.RenderTransform>
        </Image>

        <!-- ================= LAYER 2: ANIMATED LIGHT HALOS ON POSTER ELEMENTS ================= -->
        <!-- Uses a 1920x1080 Viewbox so coordinates match the poster artwork on any screen resolution -->
        <Viewbox Stretch="UniformToFill" IsHitTestVisible="False">
            <Canvas Width="1920" Height="1080">

                <!-- 1. Center Full Moon & Haunted House Eerie Pulse -->
                <Ellipse x:Name="MoonGlow"
                         Width="520" Height="520"
                         Canvas.Left="700" Canvas.Top="360"
                         Fill="{StaticResource MoonGlowBrush}"
                         Opacity="0.4"/>

                <!-- 2. Vampire's Candle Flame Flicker (Left side) -->
                <Ellipse x:Name="CandleGlow"
                         Width="220" Height="220"
                         Canvas.Left="140" Canvas.Top="520"
                         Fill="{StaticResource WarmGlowBrush}"
                         Opacity="0.75"/>

                <!-- 3. Bottom-Left Giant Jack-O'-Lantern Eyes/Mouth Pulse -->
                <Ellipse x:Name="LeftPumpkinGlow"
                         Width="340" Height="300"
                         Canvas.Left="60" Canvas.Top="650"
                         Fill="{StaticResource WarmGlowBrush}"
                         Opacity="0.6"/>

                <!-- 4. Top-Left & Top-Right Banner Pumpkins -->
                <Ellipse x:Name="TopLeftPumpkinGlow"
                         Width="220" Height="220"
                         Canvas.Left="170" Canvas.Top="90"
                         Fill="{StaticResource WarmGlowBrush}"
                         Opacity="0.5"/>
                <Ellipse x:Name="TopRightPumpkinGlow"
                         Width="220" Height="220"
                         Canvas.Left="1530" Canvas.Top="90"
                         Fill="{StaticResource WarmGlowBrush}"
                         Opacity="0.5"/>

                <!-- 5. Witch's Wand Magic Glint (Right side) -->
                <Ellipse x:Name="WandGlow"
                         Width="160" Height="160"
                         Canvas.Left="1400" Canvas.Top="340"
                          Opacity="0.7">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#99B6FF2E" Offset="0.0"/>
                            <GradientStop Color="#337A3BE0" Offset="0.5"/>
                            <GradientStop Color="#00000000" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- ================= LAYER 3: RISING FIRE EMBERS ================= -->
                <Ellipse Width="8" Height="8" Fill="#FF9E00" Canvas.Left="220" Canvas.Top="980" Opacity="0.85">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Ember1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="6" Height="6" Fill="#FF6B00" Canvas.Left="480" Canvas.Top="1020" Opacity="0.75">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Ember2"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="10" Height="10" Fill="#FFD000" Canvas.Left="760" Canvas.Top="990" Opacity="0.8">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Ember3"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="7" Height="7" Fill="#FF6B00" Canvas.Left="1180" Canvas.Top="1010" Opacity="0.75">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Ember4"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="9" Height="9" Fill="#FF9E00" Canvas.Left="1480" Canvas.Top="970" Opacity="0.85">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Ember5"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="6" Height="6" Fill="#FFD000" Canvas.Left="1720" Canvas.Top="1000" Opacity="0.7">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Ember6"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>
        </Viewbox>

        <!-- ================= LAYER 4: SUBTLE OUTER EDGE VIGNETTE ONLY ================= -->
        <!-- Completely transparent across 88% of the screen so the poster is never covered -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.72" RadiusY="0.72">
                    <GradientStop Color="#00000000" Offset="0.0"/>
                    <GradientStop Color="#00000000" Offset="0.85"/>
                    <GradientStop Color="#AA0D0B10" Offset="1.0"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- ================= LAYER 5: DISTANT LIGHTNING FLASH OVERLAY ================= -->
        <Rectangle x:Name="LightningFlash"
                   Fill="#FFFFFF"
                   Opacity="0"
                   IsHitTestVisible="False"/>

        <!-- ================= LAYER 6: THIN FRAME BORDER (NO BACKGROUND FILL!) ================= -->
        <Border BorderBrush="#FF6B00"
                BorderThickness="6"
                Margin="14"
                Background="{x:Null}"
                IsHitTestVisible="False">
            <Border BorderBrush="#0D0B10"
                    BorderThickness="3"
                    Background="{x:Null}"/>
        </Border>

        <!-- ================= ANIMATION STORYBOARDS ================= -->
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                        <!-- Subtle slow cinematic zoom on poster (1.0 -> 1.025) -->
                        <DoubleAnimation Storyboard.TargetName="PosterBreathScale"
                                         Storyboard.TargetProperty="ScaleX"
                                         From="1.0" To="1.025" Duration="0:0:6"
                                         AutoReverse="True"/>
                        <DoubleAnimation Storyboard.TargetName="PosterBreathScale"
                                         Storyboard.TargetProperty="ScaleY"
                                         From="1.0" To="1.025" Duration="0:0:6"
                                         AutoReverse="True"/>

                        <!-- Candle rapid flicker -->
                        <DoubleAnimation Storyboard.TargetName="CandleGlow"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0.35" To="0.95" Duration="0:0:0.18"
                                         AutoReverse="True"/>

                        <!-- Pumpkin & Moon breathing glow -->
                        <DoubleAnimation Storyboard.TargetName="LeftPumpkinGlow"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0.3" To="0.85" Duration="0:0:1.4"
                                         AutoReverse="True"/>
                        <DoubleAnimation Storyboard.TargetName="TopLeftPumpkinGlow"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0.25" To="0.75" Duration="0:0:1.1"
                                         AutoReverse="True"/>
                        <DoubleAnimation Storyboard.TargetName="TopRightPumpkinGlow"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0.25" To="0.75" Duration="0:0:1.3"
                                         AutoReverse="True"/>
                        <DoubleAnimation Storyboard.TargetName="MoonGlow"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0.2" To="0.65" Duration="0:0:2.5"
                                         AutoReverse="True"/>
                        <DoubleAnimation Storyboard.TargetName="WandGlow"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0.2" To="0.9" Duration="0:0:0.8"
                                         AutoReverse="True"/>

                        <!-- Rising Embers -->
                        <DoubleAnimation Storyboard.TargetName="Ember1" Storyboard.TargetProperty="Y" From="0" To="-950" Duration="0:0:5.5"/>
                        <DoubleAnimation Storyboard.TargetName="Ember1" Storyboard.TargetProperty="X" From="0" To="60" Duration="0:0:5.5"/>

                        <DoubleAnimation Storyboard.TargetName="Ember2" Storyboard.TargetProperty="Y" From="0" To="-950" Duration="0:0:4.2"/>
                        <DoubleAnimation Storyboard.TargetName="Ember2" Storyboard.TargetProperty="X" From="0" To="-50" Duration="0:0:4.2"/>

                        <DoubleAnimation Storyboard.TargetName="Ember3" Storyboard.TargetProperty="Y" From="0" To="-950" Duration="0:0:6.0"/>
                        <DoubleAnimation Storyboard.TargetName="Ember3" Storyboard.TargetProperty="X" From="0" To="45" Duration="0:0:6.0"/>

                        <DoubleAnimation Storyboard.TargetName="Ember4" Storyboard.TargetProperty="Y" From="0" To="-950" Duration="0:0:4.8"/>
                        <DoubleAnimation Storyboard.TargetName="Ember4" Storyboard.TargetProperty="X" From="0" To="-70" Duration="0:0:4.8"/>

                        <DoubleAnimation Storyboard.TargetName="Ember5" Storyboard.TargetProperty="Y" From="0" To="-950" Duration="0:0:5.1"/>
                        <DoubleAnimation Storyboard.TargetName="Ember5" Storyboard.TargetProperty="X" From="0" To="55" Duration="0:0:5.1"/>

                        <DoubleAnimation Storyboard.TargetName="Ember6" Storyboard.TargetProperty="Y" From="0" To="-950" Duration="0:0:3.9"/>
                        <DoubleAnimation Storyboard.TargetName="Ember6" Storyboard.TargetProperty="X" From="0" To="-40" Duration="0:0:3.9"/>

                        <!-- Brief double lightning flash every 6 seconds -->
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LightningFlash"
                                                       Storyboard.TargetProperty="Opacity"
                                                       Duration="0:0:6">
                            <LinearDoubleKeyFrame Value="0.0" KeyTime="0:0:0"/>
                            <LinearDoubleKeyFrame Value="0.0" KeyTime="0:0:4.2"/>
                            <LinearDoubleKeyFrame Value="0.22" KeyTime="0:0:4.25"/>
                            <LinearDoubleKeyFrame Value="0.0" KeyTime="0:0:4.32"/>
                            <LinearDoubleKeyFrame Value="0.35" KeyTime="0:0:4.38"/>
                            <LinearDoubleKeyFrame Value="0.0" KeyTime="0:0:4.55"/>
                            <LinearDoubleKeyFrame Value="0.0" KeyTime="0:0:6"/>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
    </Grid>
</Window>
